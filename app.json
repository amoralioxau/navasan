{
  "expo": {
    "name": "NAVASAN",
    "slug": "tradepsych",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/images/logo.png",
    "scheme": "tradepsych",
    "userInterfaceStyle": "automatic",
    "ios": {
      "icon": "./assets/images/logo.png",
      "supportsTablet": false,
      "infoPlist": {
        "NSMicrophoneUsageDescription": "برای ضبط یادداشت صوتی معاملات به دسترسی میکروفون نیاز داریم.",
        "NSPhotoLibraryUsageDescription": "برای انتخاب تصویر پروفایل و پیوست به معاملات به دسترسی گالری نیاز داریم.",
        "NSPhotoLibraryAddUsageDescription": "برای ذخیره تصاویر در گالری به دسترسی نیاز داریم.",
        "NSCameraUsageDescription": "برای گرفتن عکس و پیوست به معاملات به دوربین نیاز داریم."
      }
    },
    "android": {
      "package": "com.navasan.trading",
      "adaptiveIcon": {
        "foregroundImage": "./assets/images/logo.png",
        "backgroundColor": "#0B1F3A"
      },
      "predictiveBackGestureEnabled": false,
      "permissions": [
        "android.permission.RECORD_AUDIO",
        "android.permission.MODIFY_AUDIO_SETTINGS",
        "android.permission.INTERNET",
        "android.permission.ACCESS_NETWORK_STATE",
        "android.permission.VIBRATE",
        "android.permission.RECEIVE_BOOT_COMPLETED",
        "android.permission.POST_NOTIFICATIONS",
        "android.permission.READ_EXTERNAL_STORAGE",
        "android.permission.WRITE_EXTERNAL_STORAGE",
        "android.permission.CAMERA"
      ],
      "usesCleartextTraffic": true
    },
    "web": {
      "output": "static",
      "favicon": "./assets/images/favicon.png"
    },
    "plugins": [
      "expo-router",
      "expo-audio",
      [
        "expo-notifications",
        {
          "icon": "./assets/images/logo.png",
          "color": "#2563EB"
        }
      ]
    ],
    "experiments": {
      "typedRoutes": true,
      "reactCompiler": true
    },
    "extra": {
      "eas": {
        "projectId": ""
      }
    }
  }
}